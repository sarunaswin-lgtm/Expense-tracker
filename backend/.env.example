# WealthPulse Backend Environment Variables
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (100% Free via https://aistudio.google.com/)
GEMINI_API_KEY=

# Supabase Free PostgreSQL Tier (Optional for local testing, required for cloud production)
# Get these free from https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
